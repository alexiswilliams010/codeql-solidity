}

// Group Solidity-specific types into high-level classes
// All classes will be modeled after Solidity language grammar: https://docs.soliditylang.org/en/latest/grammar.html
class TExpression = 
  TArrayAccess
  or
  TAssignmentExpression
  or
  TAugmentedAssignmentExpression
  or
  TBinaryExpression
  or
  TCallExpression
  or
  TCallStructArgument
  or
  TInlineArrayExpression
  or
  TLiteral
  or
  TMemberExpression
  or
  TMetaTypeExpression
  or
  TNewExpression
  or
  TParenthesizedExpression
  or
  TPayableConversionExpression
  or
  TSliceAccess
  or
  TSolExpression
  or
  TStructExpression
  or
  TTernaryExpression
  or
  TTupleExpression
  or
  TTypeCastExpression
  or
  TUnaryExpression
  or
  TUpdateExpression
  or
  TVariableDeclaration
  or
  TYulExpression;

class TLiteral =
  TStringLiteral
  or
  TDecimalNumber
  or
  TNumberLiteral
  or
  TBooleanLiteral
  or
  THexStringLiteral
  or
  TUnicodeStringLiteral;

class TBlock = 
  TStatement
  or
  TUnchecked;

class TStatement = 
  TAssemblyStatement
  or
  TBlockStatement
  or
  TBreakStatement
  or
  TContinueStatement
  or
  TDoWhileStatement
  or
  TEmitStatement
  or
  TExpressionStatement
  or
  TForStatement
  or
  TIfStatement
  or
  TReturnStatement
  or
  TRevertStatement
  or
  TTryStatement
  or
  TVariableDeclarationStatement
  or
  TWhileStatement;

class TYulStatement = 
  TYulBlock
  or
  TYulVariableDeclaration
  or
  TYulAssignment
  or
  TYulFunctionCall
  or
  TYulIfStatement
  or
  TYulForStatement
  or
  TYulSwitchStatement
  or
  TYulLeave
  or
  TYulBreak
  or
  TYulContinue
  or
  TYulFunctionDefinition;

class TYulLiteral = 
  TYulDecimalNumber
  or
  TYulStringLiteral
  or
  TYulHexNumber
  or
  TYulBoolean
  or
  TYulHexStringLiteral;

class TYulExpression = 
  TYulPath
  or
  TYulFunctionCall
  or
  TYulLiteral;

class TDeclaration = 
  TConstantVariableDeclaration
  or
  TConstructorDefinition
  or
  TContractDeclaration
  or
  TEnumDeclaration
  or
  TErrorDeclaration
  or
  TEventDefinition
  or
  TFunctionDefinition
  or
  TInterfaceDeclaration
  or
  TLibraryDeclaration
  or
  TModifierDefinition
  or
  TStateVariableDeclaration
  or
  TStructDeclaration
  or
  TTypeAlias
  or
  TYulFunctionDefinition;

class TFunctionElement = 
  TFunctionDefinition
  or
  TModifierDefinition
  or
  TConstructorDefinition
  or
  TYulFunctionDefinition;

class TAssemblyStatement = 
  TSolAssemblyStatement
  or
  TAssemblyFlags
  or
  TYulStatement;

class TSourceUnit = 
  TImportDirective
  or
  TUsingDirective
  or
  TContractDeclaration
  or
  TInterfaceDeclaration
  or
  TLibraryDeclaration
  or
  TFunctionDefinition
  or
  TConstantVariableDeclaration
  or
  TStructDeclaration
  or
  TEnumDeclaration
  or
  TUserDefinedTypeDefinition
  or
  TErrorDeclaration
  or
  TEventDefinition;

class TContract = 
  TContractBody
  or
  TConstructorDefinition
  or
  TFunctionDefinition
  or
  TModifierDefinition
  or
  TFallbackReceiveDefinition
  or
  TStructDeclaration
  or
  TEnumDeclaration
  or
  TUserDefinedTypeDefinition
  or
  TStateVariableDeclaration
  or
  TEventDefinition
  or
  TErrorDeclaration
  or
  TUsingDirective;
